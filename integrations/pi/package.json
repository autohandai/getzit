{
	"name": "pi-zit",
	"version": "0.1.0",
	"description": "Zit for the Pi coding agent: work in a disposable Zit workspace, claim files before editing, and record the session as a change alongside other agents",
	"keywords": [
		"pi-package",
		"pi-extension",
		"zit",
		"git",
		"agents"
	],
	"license": "GPL-2.0-only",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/autohandai/getzit.git",
		"directory": "integrations/pi"
	},
	"homepage": "https://github.com/autohandai/getzit/tree/main/integrations/pi#readme",
	"files": [
		"extensions",
		"src",
		"README.md",
		"LICENSE"
	],
	"pi": {
		"extensions": [
			"./extensions/zit.ts"
		]
	},
	"scripts": {
		"test": "node --test test/*.test.ts",
		"check": "tsc --noEmit"
	},
	"engines": {
		"node": ">=22.18"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "0.84.4",
		"@types/node": "^24.0.0",
		"typebox": "^1.3.7",
		"typescript": "^5.9.0"
	}
}
