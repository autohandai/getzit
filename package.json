{
  "name": "zit-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} blume dev",
    "build": "GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} blume build",
    "doctor": "blume doctor",
