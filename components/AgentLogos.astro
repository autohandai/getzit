<ul class="zl not-prose" aria-label="Coding agents Zit works with">
  {agents.map((a) => (
    <li>
      <a href={a.href} rel="noopener">
        <svg viewBox={a.vb} aria-hidden="true" class={a.vb === "0 0 26 12" ? "wide" : ""} set:html={a.svg} />
        <span class="zl-name">{a.name}</span>
        <code>{a.how}</code>
      </a>
    </li>
  ))}
</ul>

<style>
  .zl { display: grid; grid-template-columns: repeat(auto-fit, minmax(9.5rem, 1fr)); gap: 0.75rem; margin: 1.25rem 0; padding: 0; list-style: none; }
  .zl a { display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem; height: 100%; padding: 0.9rem 1rem; border: 1px solid var(--blume-border); border-radius: var(--blume-radius); color: var(--blume-foreground); text-decoration: none; }
  .zl a:hover { background: var(--blume-muted); }
  .zl a:focus-visible { outline: 2px solid var(--blume-accent); outline-offset: 2px; }
  .zl svg { width: 1.75rem; height: 1.75rem; }
  .zl svg.wide { width: 3.5rem; }
  .zl-name { font-weight: 600; }
  .zl code { font-family: var(--blume-font-mono); font-size: 0.75rem; color: var(--blume-muted-foreground); }
</style>
